# Source whitelist; downloads, device files and build products stay local.
/*
!/.gitignore
!/README.md
!/LICENSE
!/common/
!/docs/
!/xl
!/mkxnuimg.py
!/xnu-build.sh
!/xnu-env.sh
!/xnuloader/
!/qemu/
!/tools/
!/xnu/
!/xnu-deps/
!/devices/poco-x5-pro/uefi/
!/prebuilt/
!/wifi/
!/.github/

__pycache__/
*~
*.orig
*.rej

/xnuloader/*
!/xnuloader/build.sh
!/xnuloader/efi.h
!/xnuloader/loader.c
!/xnuloader/lemonade_battery.c
!/xnuloader/lemonade_battery.h
!/xnuloader/im4p.py
!/xnuloader/mkidentity.sh
!/xnuloader/mkidentity.py
!/xnuloader/mkpayload.py

/qemu/*
!/qemu/*.sh
!/qemu/*.py

# of xnu-deps only what is ours; setup.sh fetches and builds the rest
/xnu-deps/*
!/xnu-deps/setup.sh
!/xnu-deps/gen-iig-stubs.py
!/xnu-deps/hostinc/
!/xnu-deps/iig-impl/
!/xnu-deps/host/
/xnu-deps/host/*
!/xnu-deps/host/bin/
/xnu-deps/host/bin/*
!/xnu-deps/host/bin/codesign
!/xnu-deps/host/bin/iig
!/xnu-deps/host/bin/install
!/xnu-deps/host/bin/plutil
!/xnu-deps/host/bin/sw_vers
!/xnu-deps/host/bin/xcrun
!/xnu-deps/host/bin/xnu-clang
!/xnu-deps/build/
/xnu-deps/build/*
!/xnu-deps/build/pthread/
/xnu-deps/build/pthread/*
!/xnu-deps/build/pthread/build.sh
!/xnu-deps/build/pthread/inc/
!/xnu-deps/build/lzbitmap/
/xnu-deps/build/lzbitmap/*
!/xnu-deps/build/lzbitmap/unzbm.c
!/xnu-deps/build/lzbitmap/libzbitmap.c
!/xnu-deps/build/lzbitmap/libzbitmap.h
/tools/android/f2fs-resize

# Local device material stays local, even if the source whitelist above grows.
/.userland.git/
/local/
/out/
/logs/
/fw-*/
/sysimage/rootfs/
/sysimage/*.ipsw
/sysimage/*.dmg
/userland/root/
/userland/obj/
/userland/*.apfs
.env
.env.*
!.env.example
*.pem
*.key

# System extraction and userland outputs are never implicitly tracked.
/sysimage/*
!/sysimage/fetch.sh
!/sysimage/*.py
/userland/*
!/userland/build.sh
!/userland/*.py
!/userland/rc.*
!/userland/com.redwood.*.plist
!/userland/src/
!/userland/libmini/
!/userland/var/
!/userland/tests/
!/userland/UPSTREAM-SYNC.md
/devices/oneplus-9/prebuilt/
/devices/*/local/
/devices/*/out/
/devices/*/uefi/Mu-Silicium/
